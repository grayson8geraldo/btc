//@version=6
// BTC/USDT M15 — Hybrid Regime-Switching Strategy (backtest)
//
// Two regimes:
//   TREND_UP / TREND_DOWN — pullback-to-EMA momentum entries, ATR SL, TP1 at 1R, TP2 at 2R + trailing
//   RANGE                 — mean-reversion at BB extremes, single TP at BB mid
//
// Risk: 3% base, optional martingale ×2 up to 2 steps, daily DD lock 15%, streak stop after 4 losses.
// No repaint: confirmed bars only, request.security with lookahead = barmerge.lookahead_off,
// process_orders_on_close = true, calc_on_every_tick = false.

strategy(
     title                   = "BTC M15 Hybrid Regime Strategy",
     shorttitle              = "BTC-Hybrid-Strat",
     overlay                 = true,
     initial_capital         = 200,
     currency                = currency.USD,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 0.001,
     pyramiding              = 0,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.055,
     slippage                = 3,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     max_bars_back           = 1000,
     max_labels_count        = 200)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
var string G_REGIME = "Regime detector"
adxLen        = input.int(14,  "ADX length",            minval = 5,  maxval = 50, group = G_REGIME)
adxTrendThr   = input.float(25.0, "ADX trend threshold", minval = 15, maxval = 40, group = G_REGIME)
adxRangeThr   = input.float(20.0, "ADX range threshold", minval = 10, maxval = 25, group = G_REGIME)
emaFastLen    = input.int(50,  "EMA fast",              minval = 20, maxval = 120, group = G_REGIME)
emaSlowLen    = input.int(200, "EMA slow",              minval = 100, maxval = 300, group = G_REGIME)
bbLen         = input.int(20,  "BB length",             minval = 10, maxval = 40, group = G_REGIME)
bbStdev       = input.float(2.0, "BB stdev",            minval = 1.5, maxval = 3.0, step = 0.1, group = G_REGIME)
slopeLb       = input.int(20,  "Slope linreg lookback", minval = 5, maxval = 50, group = G_REGIME)

var string G_TREND = "Trend regime entries"
emaPullLen    = input.int(20,  "Pullback EMA",          minval = 8, maxval = 50, group = G_TREND)
rsiLen        = input.int(14,  "RSI length",            minval = 5, maxval = 30, group = G_TREND)
rsiTrendLong  = input.float(50.0, "RSI long floor",     minval = 40, maxval = 60, group = G_TREND, inline = "rsi_t")
rsiTrendLongH = input.float(70.0, "RSI long ceiling",   minval = 60, maxval = 80, group = G_TREND, inline = "rsi_t")
rsiTrendShort = input.float(50.0, "RSI short ceiling",  minval = 40, maxval = 60, group = G_TREND, inline = "rsi_s")
rsiTrendShortL= input.float(30.0, "RSI short floor",    minval = 20, maxval = 40, group = G_TREND, inline = "rsi_s")

var string G_RANGE = "Range regime entries"
rsiRangeLow   = input.float(30.0, "RSI oversold",       minval = 15, maxval = 35, group = G_RANGE, inline = "rsi_r")
rsiRangeHigh  = input.float(70.0, "RSI overbought",     minval = 65, maxval = 85, group = G_RANGE, inline = "rsi_r")

var string G_EXIT = "Exits"
atrLen        = input.int(14, "ATR length", minval = 5, maxval = 30, group = G_EXIT)
slMultTrend   = input.float(1.0, "SL × ATR (trend)", minval = 0.5, maxval = 2.5, step = 0.1, group = G_EXIT)
tp1MultTrend  = input.float(1.0, "TP1 × ATR (trend)", minval = 0.5, maxval = 2.5, step = 0.1, group = G_EXIT)
tp2MultTrend  = input.float(2.0, "TP2 × ATR (trend)", minval = 1.0, maxval = 4.0, step = 0.1, group = G_EXIT)
tp1QtyPct     = input.float(50.0, "TP1 close %", minval = 25.0, maxval = 75.0, step = 5, group = G_EXIT)
slMultRange   = input.float(0.8, "SL × ATR (range)", minval = 0.4, maxval = 1.5, step = 0.1, group = G_EXIT)
useTrail      = input.bool(true, "Trailing stop after TP1", group = G_EXIT)
trailMult     = input.float(1.0, "Trailing × ATR", minval = 0.5, maxval = 2.5, step = 0.1, group = G_EXIT)
swingLb       = input.int(5, "Swing lookback for SL buffer", minval = 3, maxval = 20, group = G_EXIT)

var string G_RISK = "Risk management"
baseRiskPct   = input.float(3.0, "Base risk per trade %", minval = 0.5, maxval = 8.0, step = 0.25, group = G_RISK,
                            tooltip = "Percent of current equity risked between entry and SL")
maxLeverage   = input.float(10.0, "Max leverage", minval = 1.0, maxval = 25.0, group = G_RISK)
useMartingale = input.bool(true, "Enable martingale", group = G_RISK)
martMultiplier= input.float(2.0, "Martingale multiplier", minval = 1.2, maxval = 3.0, step = 0.1, group = G_RISK)
maxMartSteps  = input.int(2, "Max martingale steps", minval = 0, maxval = 4, group = G_RISK,
                          tooltip = "0 disables martingale entirely")
maxLossStreak = input.int(4, "Pause after N losses in row", minval = 2, maxval = 8, group = G_RISK)
dailyDDLimit  = input.float(15.0, "Daily DD limit %", minval = 3.0, maxval = 30.0, group = G_RISK)
minLot        = input.float(0.001, "Exchange min lot (BTC)", minval = 0.0001, maxval = 0.01, step = 0.0001, group = G_RISK)

var string G_FILTERS = "Filters"
htfTF         = input.timeframe("60", "HTF timeframe", group = G_FILTERS)
useHtfFilter  = input.bool(true, "Use HTF trend filter (trend regime)", group = G_FILTERS)
useTimeFilter = input.bool(true, "Block low-liquidity hours", group = G_FILTERS)
blockSession  = input.session("0200-0600", "Block session (exchange tz)", group = G_FILTERS)
useAtrFilter  = input.bool(true, "Use ATR percentile filter", group = G_FILTERS)
atrLookback   = input.int(100, "ATR percentile lookback", minval = 30, maxval = 300, group = G_FILTERS)
atrPctFloor   = input.float(20.0, "ATR floor percentile", minval = 5, maxval = 40, group = G_FILTERS)
atrPctCeil    = input.float(95.0, "ATR ceil percentile",  minval = 70, maxval = 99, group = G_FILTERS)
useFundingFlt = input.bool(false, "Use funding rate filter (manual)", group = G_FILTERS)
fundingNow    = input.float(0.01, "Current est. funding %", step = 0.001, group = G_FILTERS,
                            tooltip = "Manual input. Block longs if > +0.05, shorts if < -0.05")
useNewsFilter = input.bool(false, "Block news session", group = G_FILTERS)
newsSession   = input.session("1430-1500", "News session", group = G_FILTERS)

var string G_VIS = "Visualization"
showRegimeBg  = input.bool(true,  "Color background by regime", group = G_VIS)
showZones     = input.bool(true,  "Show EMA20/BB zones",        group = G_VIS)
showDashboard = input.bool(true,  "Show dashboard",             group = G_VIS)
showSlTp      = input.bool(true,  "Plot active SL/TP",          group = G_VIS)

// ─────────────────────────────────────────────────────────────────────────────
// CORE INDICATORS
// ─────────────────────────────────────────────────────────────────────────────
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)
float emaPull = ta.ema(close, emaPullLen)
float rsi     = ta.rsi(close, rsiLen)
float atrVal  = ta.atr(atrLen)

float bbBasis = ta.sma(close, bbLen)
float bbDev   = bbStdev * ta.stdev(close, bbLen)
float bbUpper = bbBasis + bbDev
float bbLower = bbBasis - bbDev
float bbWidth = (bbUpper - bbLower) / bbBasis

float slope50 = ta.linreg(emaFast, slopeLb, 0) - ta.linreg(emaFast, slopeLb, 5)

float bbWp40 = ta.percentile_linear_interpolation(bbWidth, 100, 40)
float bbWp60 = ta.percentile_linear_interpolation(bbWidth, 100, 60)
float atrFlr = ta.percentile_linear_interpolation(atrVal, atrLookback, atrPctFloor)
float atrCap = ta.percentile_linear_interpolation(atrVal, atrLookback, atrPctCeil)

float htfEma200 = request.security(syminfo.tickerid, htfTF, ta.ema(close, 200),
                                   lookahead = barmerge.lookahead_off)
float htfClose  = request.security(syminfo.tickerid, htfTF, close,
                                   lookahead = barmerge.lookahead_off)
bool htfBull = htfClose > htfEma200
bool htfBear = htfClose < htfEma200

// ─────────────────────────────────────────────────────────────────────────────
// REGIME CLASSIFIER
// ─────────────────────────────────────────────────────────────────────────────
isTrendUp = adx > adxTrendThr and close > emaSlow and slope50 > 0 and bbWidth > bbWp40
isTrendDn = adx > adxTrendThr and close < emaSlow and slope50 < 0 and bbWidth > bbWp40
isRange   = adx < adxRangeThr and bbWidth < bbWp60

// 1 = TREND_UP, -1 = TREND_DOWN, 0 = RANGE, 2 = NEUTRAL
int regime = isTrendUp ? 1 : isTrendDn ? -1 : isRange ? 0 : 2

regimeStr() =>
    switch regime
        1  => "TREND UP"
        -1 => "TREND DOWN"
        0  => "RANGE"
        =>    "NEUTRAL"

// ─────────────────────────────────────────────────────────────────────────────
// FILTERS
// ─────────────────────────────────────────────────────────────────────────────
inBlockedSession = useTimeFilter and not na(time(timeframe.period, blockSession))
inNewsSession    = useNewsFilter and not na(time(timeframe.period, newsSession))
volOK            = not useAtrFilter or (atrVal > atrFlr and atrVal < atrCap)
fundingLongOK    = not useFundingFlt or fundingNow <= 0.05
fundingShortOK   = not useFundingFlt or fundingNow >= -0.05
filtersBaseOK    = not inBlockedSession and not inNewsSession and volOK

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY CONDITIONS (confirmed bars only)
// ─────────────────────────────────────────────────────────────────────────────
pulledBack    = ta.lowest(low, 3) <= emaPull
pulledUpToEma = ta.highest(high, 3) >= emaPull

trendLongCond  = regime == 1  and pulledBack    and close > emaPull and rsi > rsiTrendLong  and rsi < rsiTrendLongH and (not useHtfFilter or htfBull)
trendShortCond = regime == -1 and pulledUpToEma and close < emaPull and rsi < rsiTrendShort and rsi > rsiTrendShortL and (not useHtfFilter or htfBear)

rangeLongCond  = regime == 0 and close <= bbLower and rsi < rsiRangeLow  and low  == ta.lowest(low,  10)
rangeShortCond = regime == 0 and close >= bbUpper and rsi > rsiRangeHigh and high == ta.highest(high, 10)

confirm = barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// MARTINGALE / RISK STATE
// ─────────────────────────────────────────────────────────────────────────────
var float currentRiskMult = 1.0
var int   martingaleStep  = 0
var int   consecLosses    = 0
var float dayStartEquity  = strategy.equity
var float pausedUntil     = 0
var int   prevClosed      = 0
var float lastEntryRisk   = 0.0       // risk_pct used on the live trade

newDay = ta.change(time("D")) != 0
if newDay
    dayStartEquity := strategy.equity

// Detect newly closed trade and update streak/martingale
if strategy.closedtrades > prevClosed
    pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if pnl < 0
        consecLosses += 1
        if useMartingale and martingaleStep < maxMartSteps
            martingaleStep += 1
            currentRiskMult := math.pow(martMultiplier, martingaleStep)
        else
            // chain exhausted — reset
            martingaleStep := 0
            currentRiskMult := 1.0
    else
        martingaleStep := 0
        currentRiskMult := 1.0
        consecLosses := 0

    if consecLosses >= maxLossStreak
        pausedUntil := time + 24 * 60 * 60 * 1000
        consecLosses := 0

    prevClosed := strategy.closedtrades

// Daily DD lock
dailyPnL  = (strategy.equity - dayStartEquity) / dayStartEquity * 100
ddLocked  = dailyPnL <= -dailyDDLimit
streakLck = time < pausedUntil
tradingPaused = ddLocked or streakLck

// Force-close active position if daily DD just tripped
if ddLocked and strategy.position_size != 0
    strategy.close_all(comment = "DAILY_DD_LOCK", alert_message = "Daily DD lock — flat all")

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────
calcQty(float entry, float sl) =>
    riskPct  = baseRiskPct * currentRiskMult
    riskUSD  = strategy.equity * riskPct / 100.0
    dist     = math.abs(entry - sl)
    rawQty   = dist > 0 ? riskUSD / dist : 0.0
    notional = rawQty * entry
    maxNot   = strategy.equity * maxLeverage
    cappedQty= notional > maxNot ? maxNot / entry : rawQty
    finalQty = math.max(cappedQty, minLot)
    [finalQty, riskPct]

// ─────────────────────────────────────────────────────────────────────────────
// PRICE LEVELS PER REGIME
// ─────────────────────────────────────────────────────────────────────────────
swingLow  = ta.lowest(low,  swingLb)
swingHigh = ta.highest(high, swingLb)

slLongTrend  = math.min(close - atrVal * slMultTrend, swingLow  - atrVal * 0.2)
slShortTrend = math.max(close + atrVal * slMultTrend, swingHigh + atrVal * 0.2)
tp1Long      = close + atrVal * tp1MultTrend
tp2Long      = close + atrVal * tp2MultTrend
tp1Short     = close - atrVal * tp1MultTrend
tp2Short     = close - atrVal * tp2MultTrend

slLongRange  = close - atrVal * slMultRange
slShortRange = close + atrVal * slMultRange
tpLongRange  = bbBasis
tpShortRange = bbBasis

// ─────────────────────────────────────────────────────────────────────────────
// ENTRIES & EXITS
// ─────────────────────────────────────────────────────────────────────────────
canEnter = confirm and not tradingPaused and filtersBaseOK and strategy.position_size == 0

var float activeSL  = na
var float activeTP1 = na
var float activeTP2 = na
var bool  isTrendTrade = false
var bool  tp1Hit       = false

// LONG TREND
if canEnter and trendLongCond and fundingLongOK
    [q, rp] = calcQty(close, slLongTrend)
    activeSL  := slLongTrend
    activeTP1 := tp1Long
    activeTP2 := tp2Long
    isTrendTrade := true
    tp1Hit := false
    lastEntryRisk := rp
    strategy.entry("L-T", strategy.long, qty = q,
                   alert_message = "LONG-TREND entry  qty=" + str.tostring(q, "#.####") +
                                   "  risk%=" + str.tostring(rp, "#.##"))
    strategy.exit("L-T tp1", "L-T", qty_percent = tp1QtyPct, stop = activeSL, limit = activeTP1,
                  alert_message = "LONG-TREND TP1/SL")
    strategy.exit("L-T tp2", "L-T", stop = activeSL, limit = activeTP2,
                  alert_message = "LONG-TREND TP2/SL")

// SHORT TREND
if canEnter and trendShortCond and fundingShortOK
    [q, rp] = calcQty(close, slShortTrend)
    activeSL  := slShortTrend
    activeTP1 := tp1Short
    activeTP2 := tp2Short
    isTrendTrade := true
    tp1Hit := false
    lastEntryRisk := rp
    strategy.entry("S-T", strategy.short, qty = q,
                   alert_message = "SHORT-TREND entry  qty=" + str.tostring(q, "#.####") +
                                   "  risk%=" + str.tostring(rp, "#.##"))
    strategy.exit("S-T tp1", "S-T", qty_percent = tp1QtyPct, stop = activeSL, limit = activeTP1,
                  alert_message = "SHORT-TREND TP1/SL")
    strategy.exit("S-T tp2", "S-T", stop = activeSL, limit = activeTP2,
                  alert_message = "SHORT-TREND TP2/SL")

// LONG RANGE
if canEnter and rangeLongCond and fundingLongOK
    [q, rp] = calcQty(close, slLongRange)
    activeSL  := slLongRange
    activeTP1 := tpLongRange
    activeTP2 := na
    isTrendTrade := false
    tp1Hit := false
    lastEntryRisk := rp
    strategy.entry("L-R", strategy.long, qty = q,
                   alert_message = "LONG-RANGE entry  qty=" + str.tostring(q, "#.####") +
                                   "  risk%=" + str.tostring(rp, "#.##"))
    strategy.exit("L-R x", "L-R", stop = activeSL, limit = activeTP1,
                  alert_message = "LONG-RANGE TP/SL")

// SHORT RANGE
if canEnter and rangeShortCond and fundingShortOK
    [q, rp] = calcQty(close, slShortRange)
    activeSL  := slShortRange
    activeTP1 := tpShortRange
    activeTP2 := na
    isTrendTrade := false
    tp1Hit := false
    lastEntryRisk := rp
    strategy.entry("S-R", strategy.short, qty = q,
                   alert_message = "SHORT-RANGE entry  qty=" + str.tostring(q, "#.####") +
                                   "  risk%=" + str.tostring(rp, "#.##"))
    strategy.exit("S-R x", "S-R", stop = activeSL, limit = activeTP1,
                  alert_message = "SHORT-RANGE TP/SL")

// Trail stop / move-to-breakeven on trend trades after TP1.
// Re-issuing strategy.exit with the same ID/from_entry updates the existing exit order,
// so we keep "L-T tp2" / "S-T tp2" as the single trailing exit on the remaining qty.
if useTrail and isTrendTrade and strategy.position_size != 0
    entryPx = strategy.position_avg_price
    if strategy.position_size > 0 and not tp1Hit and high >= activeTP1
        tp1Hit   := true
        activeSL := entryPx
        strategy.exit("L-T tp2", "L-T", stop = activeSL, limit = activeTP2,
                      alert_message = "LONG-TREND BE move")
    if strategy.position_size < 0 and not tp1Hit and low <= activeTP1
        tp1Hit   := true
        activeSL := entryPx
        strategy.exit("S-T tp2", "S-T", stop = activeSL, limit = activeTP2,
                      alert_message = "SHORT-TREND BE move")

    // Chandelier-style trailing: tighten SL by trailMult * ATR from extreme.
    if tp1Hit and strategy.position_size > 0
        newSL = ta.highest(high, 5) - atrVal * trailMult
        if newSL > activeSL
            activeSL := newSL
            strategy.exit("L-T tp2", "L-T", stop = activeSL, limit = activeTP2)
    if tp1Hit and strategy.position_size < 0
        newSL = ta.lowest(low, 5) + atrVal * trailMult
        if newSL < activeSL
            activeSL := newSL
            strategy.exit("S-T tp2", "S-T", stop = activeSL, limit = activeTP2)

// Reset cached levels when flat
if strategy.position_size == 0
    activeSL  := na
    activeTP1 := na
    activeTP2 := na
    tp1Hit    := false

// ─────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────
plot(showZones ? emaPull : na, "EMA pull", color = color.new(color.orange, 0))
plot(showZones ? emaFast : na, "EMA fast", color = color.new(color.blue, 0))
plot(showZones ? emaSlow : na, "EMA slow", color = color.new(color.purple, 0), linewidth = 2)
plot(showZones ? bbUpper : na, "BB upper", color = color.new(color.gray, 60))
plot(showZones ? bbLower : na, "BB lower", color = color.new(color.gray, 60))
plot(showZones ? bbBasis : na, "BB basis", color = color.new(color.gray, 40))

bgcolor(showRegimeBg and regime ==  1 ? color.new(color.green,  92) : na, title = "Trend up bg")
bgcolor(showRegimeBg and regime == -1 ? color.new(color.red,    92) : na, title = "Trend down bg")
bgcolor(showRegimeBg and regime ==  0 ? color.new(color.yellow, 92) : na, title = "Range bg")
bgcolor(tradingPaused ? color.new(color.maroon, 85) : na, title = "Paused")

plot(showSlTp ? activeSL  : na, "Active SL",  color = color.new(color.red,   0), style = plot.style_linebr, linewidth = 1)
plot(showSlTp ? activeTP1 : na, "Active TP1", color = color.new(color.lime,  0), style = plot.style_linebr, linewidth = 1)
plot(showSlTp ? activeTP2 : na, "Active TP2", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 10, border_width = 1, frame_color = color.gray, frame_width = 1)
if showDashboard and barstate.islast
    rcolor = regime ==  1 ? color.new(color.green,  20) :
             regime == -1 ? color.new(color.red,    20) :
             regime ==  0 ? color.new(color.yellow, 20) : color.new(color.gray, 30)

    pcolor = tradingPaused ? color.new(color.red, 30) : color.new(color.green, 60)
    pTxt   = ddLocked ? "DAILY DD" : streakLck ? "STREAK" : "OK"

    table.cell(dash, 0, 0, "Metric", bgcolor = color.new(color.gray, 0), text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "Value",  bgcolor = color.new(color.gray, 0), text_color = color.white, text_size = size.small)

    table.cell(dash, 0, 1, "Regime", text_size = size.small)
    table.cell(dash, 1, 1, regimeStr(), bgcolor = rcolor, text_size = size.small)

    table.cell(dash, 0, 2, "Equity",       text_size = size.small)
    table.cell(dash, 1, 2, "$" + str.tostring(strategy.equity, "#.##"), text_size = size.small)

    table.cell(dash, 0, 3, "Day P&L %",    text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(dailyPnL, "#.##") + "%",
               bgcolor = dailyPnL >= 0 ? color.new(color.green, 70) : color.new(color.red, 70),
               text_size = size.small)

    table.cell(dash, 0, 4, "Mart step",    text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(martingaleStep) + "  (×" + str.tostring(currentRiskMult, "#.##") + ")",
               bgcolor = martingaleStep > 0 ? color.new(color.orange, 50) : color.new(color.green, 70),
               text_size = size.small)

    table.cell(dash, 0, 5, "Loss streak",  text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(consecLosses) + " / " + str.tostring(maxLossStreak), text_size = size.small)

    table.cell(dash, 0, 6, "Status",       text_size = size.small)
    table.cell(dash, 1, 6, pTxt, bgcolor = pcolor, text_size = size.small)

    table.cell(dash, 0, 7, "Last risk %",  text_size = size.small)
    table.cell(dash, 1, 7, str.tostring(lastEntryRisk, "#.##") + "%", text_size = size.small)

    table.cell(dash, 0, 8, "ATR",          text_size = size.small)
    table.cell(dash, 1, 8, str.tostring(atrVal, "#.##"), text_size = size.small)

    table.cell(dash, 0, 9, "Trades",       text_size = size.small)
    table.cell(dash, 1, 9, str.tostring(strategy.closedtrades) + "  (W:" +
               str.tostring(strategy.wintrades) + " / L:" + str.tostring(strategy.losstrades) + ")",
               text_size = size.small)

// ─────────────────────────────────────────────────────────────────────────────
// META ALERTS
// ─────────────────────────────────────────────────────────────────────────────
if confirm and ta.change(regime) != 0
    alert("REGIME CHANGE → " + regimeStr(), alert.freq_once_per_bar_close)

if newDay and ddLocked
    alert("DAILY DD LOCK active — trading paused for the day", alert.freq_once_per_bar)
